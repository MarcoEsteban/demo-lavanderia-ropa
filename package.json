{
  "name": "demo-lavanderia-ropa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lavandería por kilo + tablero de producción + entrega sobre Google Apps Script y Sheets",
  "scripts": {
    "push": "clasp push",
    "pull": "clasp pull",
    "watch": "clasp push --watch",
    "logs": "clasp tail-logs --watch",
    "open": "clasp open-script",
    "deploy": "node scripts/deploy.mjs",
    "check": "node --check src/Codigo.js && node --check src/Operaciones.js",
    "test": "TZ=America/La_Paz node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^3.4.1",
    "@types/google-apps-script": "^2.0.13"
  }
}
